rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'admin@hindiocr.pro' ||
        request.auth.token.email == 'dot91siwan@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{docId} {
      // Allow searching for user status by username (needed for pre-login lock check)
      allow list, get: if true; 
      
      // Validation for create/update
      function isValidUser(data) {
        return data.uid is string && 
               data.username is string && data.username.size() <= 100 &&
               data.role in ['user', 'admin'] &&
               data.password is string &&
               data.credits is number &&
               data.status in ['active', 'locked'] &&
               data.createdAt is timestamp;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow create: if isSignedIn() && (
        (request.resource.data.uid == request.auth.uid) || isAdmin()
      ) && isValidUser(request.resource.data);

      allow update: if isAdmin() || (
        isOwner(resource.data.uid) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits'])
      ) || (
        // Allow unauthenticated update for security tracking (locking accounts)
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['failedAttempts', 'status', 'updatedAt']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['failedAttempts', 'status', 'updatedAt'])
      );
      
      allow delete: if isAdmin();
    }
  }
}
